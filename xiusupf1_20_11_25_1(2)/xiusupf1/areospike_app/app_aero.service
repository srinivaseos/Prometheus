[Unit]
Description=app_aero
After=networking.service

[Service]
Type=simple

User=dpdk
Group=dpdk

StandardOutput=syslog
StandardError=syslog
Restart=always
WorkingDirectory=/home/dpdk/xiusupf/areospike_app/
ExecStart=/home/dpdk/xiusupf/areospike_app/app_aero ./aero.json
RestartSec=2
RestartPreventExitStatus=1
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
